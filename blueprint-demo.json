{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/?pagename=library",
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/aaronwsmith12/reference-library",
        "ref": "HEAD",
        "refType": "refname"
      },
      "options": {
        "targetFolderName": "reference-library"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/reference-library/playground-setup.php';"
    }
  ]
}